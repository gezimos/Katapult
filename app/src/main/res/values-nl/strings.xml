    <string name="lockscreen_reenable_message">Toegankelijkheidstoegang wordt uitgeschakeld bij het bijwerken van de app. Schakel deze opnieuw in om de functies te blijven gebruiken die deze nodig hebben.</string>
    <string name="lockscreen_reenable_enable">Inschakelen in instellingen</string>
