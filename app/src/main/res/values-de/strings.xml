    <string name="lockscreen_reenable_message">Der Bedienungshilfen-Zugriff wird beim Aktualisieren der App deaktiviert. Aktiviere ihn erneut, damit die Funktionen, die ihn benötigen, weiter funktionieren.</string>
    <string name="lockscreen_reenable_enable">In Einstellungen aktivieren</string>
