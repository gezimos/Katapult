    <string name="a11y_service_label">Katapult Action Service</string>
    <string name="a11y_shortcut_warning">In accessibility settings, turn on only the Katapult Action Service itself, not its shortcut. The shortcut adds a floating accessibility button to your screen.</string>
    <string name="lockscreen_widget_a11y_desc">Used for the lockscreen notification widget, covering the status bar clock, locking the phone, and the screensaver. Draws only over the lock screen and status bar; reads nothing from your apps.</string>
