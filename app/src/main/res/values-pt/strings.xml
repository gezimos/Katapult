    <string name="lockscreen_reenable_message">O acesso de acessibilidade é desativado ao atualizar a app. Ative-o novamente para continuar a usar as funcionalidades que dele precisam.</string>
    <string name="lockscreen_reenable_enable">Ativar nas definições</string>
