    <string name="lockscreen_reenable_message">Přístup k usnadnění přístupu se při aktualizaci aplikace vypne. Povolte jej znovu, aby funkce, které jej potřebují, dál fungovaly.</string>
    <string name="lockscreen_reenable_enable">Povolit v nastavení</string>
