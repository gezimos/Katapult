    <string name="a11y_service_label">Katapult Action Service</string>
    <string name="a11y_shortcut_warning">V nastavení přístupnosti zapněte pouze samotnou službu Katapult Action Service, ne její zkratku. Zkratka přidá na obrazovku plovoucí tlačítko přístupnosti.</string>
    <string name="lockscreen_widget_a11y_desc">Používá se pro widget oznámení na zamykací obrazovce, zakrytí hodin stavového řádku, zamknutí telefonu a spořič. Kreslí pouze přes zamykací obrazovku a stavový řádek; z vašich aplikací nic nečte.</string>
