    <string name="lockscreen_sort">Sortowanie na ekranie blokady</string>
    <string name="sort_latest_top">Najnowsze na górze</string>
    <string name="sort_oldest_top">Najstarsze na górze</string>
    <string name="lockscreen_reenable_message">Dostęp ułatwień dostępu jest wyłączany przy aktualizacji aplikacji. Włącz go ponownie, aby dalej korzystać z funkcji, które go wymagają.</string>
    <string name="lockscreen_reenable_enable">Włącz w ustawieniach</string>
